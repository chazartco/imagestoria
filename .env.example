# ImageStoria settings. Copy this file to .env and edit it. Lines starting with # are notes.
# Restart the app after any change: docker compose up -d

# ---------- Address ----------
# The address people type in the browser. With https the sign-in cookie is marked secure,
# and sign-in links (invites, SolPersona) are built from this value, so it must be exact.
PUBLIC_URL=http://localhost:8080

# Docker Compose only: which network interface and port the app is published on.
APP_BIND=127.0.0.1
APP_PORT=8080

# Docker Compose only: password for the bundled Postgres. Choose it before the first start: the database
# keeps the password it was created with. Avoid @ : / # ? and spaces, which mean something inside an address.
POSTGRES_PASSWORD=change-me-to-something-long

# Running without the bundled Postgres? Point at your own instead (Compose sets this for you otherwise).
# DATABASE_URL=postgres://user:password@host:5432/afterimage

# ---------- Sign-in ----------
# Email and password accounts kept in this app's own database. On unless set to false.
LOCAL_AUTH=true

# Single sign-on through SolPersona, or any other OpenID Connect provider.
# It turns on when OIDC_ISSUER and OIDC_CLIENT_ID are both set. Both ways of signing in can be on together.
# Register this redirect address with the provider:  <PUBLIC_URL>/api/auth/oidc/callback
OIDC_NAME=SolPersona
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email

# How long a sign-in lasts, in days.
SESSION_DAYS=30

# ---------- Email ----------
# Optional. With a Resend key set, an invite to an email address is sent to that address, and so is a
# password reset link. Without it nothing is sent, and the owner copies the links by hand as before.
# Get a key at https://resend.com. The domain in MAIL_FROM must be verified in Resend first
# (Resend, Domains, Add domain, then add the DNS records it shows). Until it is, Resend refuses the mail.
# Check the setup with:  docker compose exec app npm run mail:test -- you@example.com
RESEND_API_KEY=
# Who the mail comes from. Example: ImageStoria <photos@example.com>
MAIL_FROM=
# Optional. Where a reply goes, if not to MAIL_FROM.
MAIL_REPLY_TO=

# ---------- Where the files live ----------
# local: a folder (the "media" volume in Docker Compose).
# s3:    any S3-compatible bucket, such as DigitalOcean Spaces, AWS S3, Backblaze B2 or MinIO.
STORAGE_DRIVER=local

# For s3. Example for DigitalOcean Spaces in NYC3:
#   S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
#   S3_REGION=us-east-1          (keep this for Spaces: the endpoint decides the real region)
#   S3_BUCKET=your-space-name
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional folder inside the bucket, so the bucket can be shared with other things. Example: afterimage
S3_PREFIX=
# true for MinIO and other servers that want the bucket in the path instead of the host name.
S3_FORCE_PATH_STYLE=false
# redirect: the browser fetches each file straight from the bucket through a signed link that expires. Fast, and the bucket stays private.
# proxy:    every file streams through this app. Use it if the bucket is not reachable from people's browsers.
S3_DELIVERY=redirect
S3_URL_TTL_SECONDS=3600

# ---------- Pictures ----------
# Largest single upload, in megabytes.
MAX_UPLOAD_MB=8192
# Long edge of the display copy, and height of thumbnails, in pixels. Changing these affects new uploads only.
DISPLAY_LONG_EDGE=1600
THUMB_HEIGHT=360
# How many uploads are processed at the same time. Raise it on a machine with many cores and plenty of memory.
INGEST_CONCURRENCY=2

# ---------- Map ----------
# Map styles for MapLibre. The defaults are OpenFreeMap: free, no key, no account.
# Any MapLibre style address works, including a tile server of your own.
MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
MAP_STYLE_FALLBACK=https://tiles.openfreemap.org/styles/liberty

# ---------- Reels ----------
# A reel is a story made into one video file. These keep a single reel from tying the server up for too long.
# The most pictures and videos one reel may hold, and the longest stretch of any one video that goes in, in seconds.
REEL_MAX_ITEMS=200
REEL_VIDEO_MAX_SECONDS=20

# ---------- Trash ----------
# Some videos do not play in a browser (iPhone HEVC and HDR, MKV, AVI). The app keeps the original untouched and
# makes an H.264 MP4 copy to play instead. auto: only when needed. always: for every video. never: no copies.
VIDEO_COPY=auto
# The longest side of that copy, in pixels. The copy keeps the shape of the original.
VIDEO_COPY_MAX_EDGE=1920

# ---------- Backups of the database ----------
# Titles, tags, comments, stories, people and edits live in the database. This writes a compressed dump of it once a
# day to the same place the files are kept, under backups/. Empty or "off" turns it off. A time of day, on the
# server's clock, turns it on. It covers the database only: the pictures and videos need their own second copy.
BACKUP_SCHEDULE=
# How many backups to keep. The oldest beyond this are removed.
BACKUP_KEEP=14
# Recommended. The dump holds password hashes and token hashes. With a passphrase it is encrypted before it is
# stored. Keep the passphrase somewhere other than this server: without it the backups cannot be opened.
BACKUP_PASSPHRASE=

# Workers are programs on your own machines that read the pictures (see "Workers" in the README).
# A worker holds each item it claims for this many minutes. If it goes quiet for that long, the item goes back in line.
AI_LEASE_MINUTES=10
# How many times one task is tried on one item before it is marked as failed.
AI_MAX_ATTEMPTS=3
# Which kinds of work the site hands out: caption, embed (search by meaning), faces (people), place (a guess at where).
# Leave one out to turn it off for every worker.
AI_TASKS=caption,embed,faces,place

# Search by meaning. The worker's [embed] model must be this same model.
EMBED_MODEL=onnx-community/siglip2-base-patch16-224-ONNX
# The words someone types are turned into numbers on this server's CPU. It fetches the text half of the model once
# from Hugging Face into DATA_DIR/models (about 320 MB) and uses about 800 MB of memory while loaded.
# false turns search by meaning off and uses no memory.
EMBED_TEXT=true
# q8 is the small file. fp32 is exact, four times the size and twice the memory.
EMBED_TEXT_DTYPE=q8
# The text model is let go this many minutes after the last search, to give its memory back. 0 keeps it loaded.
EMBED_TEXT_IDLE_MINUTES=15
# A result is shown when it scores at least the floor and within the spread of the best match. These suit the default model.
SEARCH_MEANING_FLOOR=0.085
SEARCH_MEANING_SPREAD=0.03
SEARCH_MEANING_MAX=60
# "More like this" offers pictures at least this alike, from 0 to 1.
SIMILAR_FLOOR=0.9
# Near duplicates: how alike a picture must look to the first of its group, and how many minutes after the one before it.
DUPLICATE_SIMILARITY=0.97
DUPLICATE_MINUTES=2

# People. Likenesses between two faces, from 0 to 1. Unnamed faces this alike are grouped.
FACE_CLUSTER=0.45
# A face this like a named person is offered as a suggestion.
FACE_SUGGEST=0.35
# Automatic naming is off until the owner turns it on, on the People page, and picks the threshold there. This is where it starts.
FACE_AUTO=0.6
# It also needs this many confirmed faces of the person, and this much of a lead over the next closest person.
FACE_AUTO_MIN_CONFIRMED=5
FACE_GAP=0.1
# Each automatic name that is undone raises the threshold for that person by this much.
FACE_STRICT_STEP=0.03

# Suggested locations. A picture with none borrows from one the same camera took within this many minutes. 0 turns it off.
PLACE_NEARBY_MINUTES=10
# A place a vision model names is shown when the model is at least this sure.
PLACE_SUGGEST_MIN=0.6

# Deleted items wait in the trash. 0 keeps them until the owner deletes them for good.
# A number removes them, files included, that many days after they were deleted.
TRASH_DAYS=0

# ---------- Rarely changed ----------
# The app sits behind a reverse proxy and should believe its forwarded headers. Set to false if it is exposed directly.
TRUST_PROXY=true
LOG_LEVEL=info
