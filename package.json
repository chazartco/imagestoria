{
  "name": "afterimage",
  "version": "1.0.2",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "ImageStoria by Chaz.Art. Self-hosted image archive, viewer, editor and storyteller.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "node scripts/build-web.mjs",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "import": "node dist/server/cli-import.js",
    "mail:test": "node dist/server/cli-mail.js",
    "video:copies": "node dist/server/cli-video.js",
    "backup": "node dist/server/cli-backup.js",
    "places": "node dist/server/cli-places.js",
    "faces": "node dist/server/cli-faces.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build-web.mjs && tsx --test test/*.test.ts",
    "test:e2e": "tsx test/e2e.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/lib-storage": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@huggingface/transformers": "^4.3.2",
    "@node-rs/argon2": "^2.2.2",
    "all-the-cities": "^3.1.0",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "fastify": "^5.12.8",
    "heic-convert": "^2.1.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "maplibre-gl": "^4.7.1",
    "s3rver": "^3.7.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
